    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Parses the daily briefing (sections EMAILS / EVENTS / TASKS) into structured JSON.\n// Input: $json.output  |  Mode: Run Once for Each Item\nconst raw = String($json.output ?? '');\n\nconst MONTHS = { jan:1, feb:2, mar:3, apr:4, may:5, jun:6, jul:7, aug:8, sep:9, oct:10, nov:11, dec:12 };\nconst pad = (n) => String(n).padStart(2, '0');\n\n// \"20 Oct 2026\" -> \"2026-10-20\"\nfunction toIsoDate(s) {\n  const m = String(s ?? '').match(/(\\d{1,2})\\s+([A-Za-z]{3})[a-z]*\\.?,?\\s+(\\d{4})/);\n  if (!m || !MONTHS[m[2].toLowerCase()]) return null;\n  return `${m[3]}-${pad(MONTHS[m[2].toLowerCase()])}-${pad(m[1])}`;\n}\n\n// \"20 Oct 2026, 14:35\" -> { date: \"2026-10-20\", time: \"14:35\" }\nfunction parseSent(s) {\n  const date = toIsoDate(s);\n  const t = String(s ?? '').match(/(\\d{1,2}):(\\d{2})/);\n  return { date, time: t ? `${pad(t[1])}:${t[2]}` : null };\n}\n\nconst out = {\n  title: null,\n  date: null,\n  emails: { none: false, count: 0, items: [] },\n  events: { none: false, count: 0, items: [] },\n  tasks: { none: false, count: 0, items: [] },\n  unparsed: [],\n  raw,\n};\n\nlet section = null;\nlet email = null;        // email currently being built\nlet lastField = null;    // for wrapped lines inside an email\n\nconst flushEmail = () => {\n  if (email) out.emails.items.push(email);\n  email = null; lastField = null;\n};\n\nfor (const lineRaw of raw.split(/\\r?\\n/)) {\n  const line = lineRaw.trim();\n  if (!line) { continue; }\n\n  // Title line\n  const title = line.match(/^Daily Briefing\\s*-\\s*(.+)$/i);\n  if (title && !section) {\n    out.title = line;\n    out.date = toIsoDate(title[1]);\n    continue;\n  }\n\n  const head = line.match(/^(EMAILS|EVENTS|TASKS)$/);\n  if (head) { flushEmail(); section = head[1]; continue; }\n\n  switch (section) {\n    case 'EMAILS': {\n      if (/^no unread emails/i.test(line)) { out.emails.none = true; break; }\n      const f = line.match(/^(Sender|Subject|Sent|Summary)\\s*:\\s*(.*)$/i);\n      if (f) {\n        const key = f[1].toLowerCase();\n        if (key === 'sender') { flushEmail(); email = { senderName: '', subject: '', sentRaw: '', sentDate: null, sentTime: null, summary: '' }; }\n        if (!email) { email = { senderName: '', subject: '', sentRaw: '', sentDate: null, sentTime: null, summary: '' }; }\n        const val = f[2].trim();\n        if (key === 'sender') email.senderName = val;\n        else if (key === 'subject') email.subject = val;\n        else if (key === 'sent') { email.sentRaw = val; const p = parseSent(val); email.sentDate = p.date; email.sentTime = p.time; }\n        else if (key === 'summary') email.summary = val;\n        lastField = key;\n      } else if (email && lastField) {\n        // wrapped continuation of the previous field\n        if (lastField === 'summary') email.summary += ' ' + line;\n        else if (lastField === 'subject') email.subject += ' ' + line;\n        else out.unparsed.push({ section, line });\n      } else {\n        out.unparsed.push({ section, line });\n      }\n      break;\n    }\n\n    case 'EVENTS': {\n      if (/^no events/i.test(line)) { out.events.none = true; break; }\n\n      const timed = line.match(/^[-•*]\\s*(.+?)\\s+-\\s+(\\d{1,2}:\\d{2})\\s*[-–]\\s*(\\d{1,2}:\\d{2})(?:\\s+-\\s+Location:\\s*(.+))?$/i);\n      const allDay = line.match(/^[-•*]\\s*(.+?)\\s+-\\s+all[ -]day$/i);\n\n      if (timed) {\n        out.events.items.push({\n          name: timed[1].trim(),\n          start: timed[2],\n          end: timed[3],\n          allDay: false,\n          timeSlot: `${timed[2]} - ${timed[3]}`,\n          location: timed[4]?.trim() || null\n        });\n      } else if (allDay) {\n        out.events.items.push({\n          name: allDay[1].trim(),\n          start: null,\n          end: null,\n          allDay: true,\n          timeSlot: 'All day',\n          location: null\n        });\n      } else out.unparsed.push({ section, line });\n      break;\n    }\n\n    case 'TASKS': {\n      if (/^no tasks/i.test(line)) { out.tasks.none = true; break; }\n\n      const t = line.match(/^[-•*]\\s*(.+?)(?:\\s+-\\s+Due\\s*:\\s*(.+))?$/i);\n\n      if (t) {\n        const due = t[2] ? t[2].trim() : null;\n        const timeMatch = due?.match(/\\b(\\d{1,2}:\\d{2})\\b/);\n\n        out.tasks.items.push({\n          name: t[1].trim(),\n          dueRaw: due,\n          dueDate: due ? toIsoDate(due) : null,\n          dueTime: timeMatch ? timeMatch[1] : null\n        });\n      } else out.unparsed.push({ section, line });\n      break;\n    }\n\n    default:\n      out.unparsed.push({ section: null, line });\n  }\n}\n\nflushEmail();\n\n// Guarantee oldest -> newest for emails\nconst key = (e) => (e.sentDate && e.sentTime) ? `${e.sentDate}T${e.sentTime}` : '';\nout.emails.items = out.emails.items\n  .map((e, i) => ({ e, i }))\n  .sort((a, b) => (key(a.e) < key(b.e) ? -1 : key(a.e) > key(b.e) ? 1 : a.i - b.i))\n  .map(x => x.e);\n\nout.emails.count = out.emails.items.length;\nout.events.count = out.events.items.length;\nout.tasks.count = out.tasks.items.length;\nif (out.emails.count) out.emails.none = false;\nif (out.events.count) out.events.none = false;\nif (out.tasks.count) out.tasks.none = false;\n\nreturn { json: out };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        7472,
        928
      ],
      "id": "b1dd9c58-6ffe-4211-a39e-dbf54fa041b5",
      "name": "Code in JavaScript2"
    },
    {
      "parameters": {
        "jsCode": "const data = $json;\n\nconst escapeHtml = (value) =>\n  String(value ?? '')\n    .replace(/&/g, '&amp;')\n    .replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;')\n    .replace(/\"/g, '&quot;')\n    .replace(/'/g, '&#39;');\n\nconst sectionStyle = `\n  font-family: Arial, Helvetica, sans-serif;\n  color: #202124;\n`;\n\nconst headingStyle = `\n  font-size: 17px;\n  font-weight: 600;\n  color: #202124;\n  margin: 24px 0 12px;\n  padding-bottom: 8px;\n  border-bottom: 1px solid #dadce0;\n`;\n\nconst mutedStyle = `\n  color: #5f6368;\n  font-size: 13px;\n`;\n\nconst cardStyle = `\n  padding: 12px 14px;\n  margin-bottom: 10px;\n  border: 1px solid #e0e3e7;\n  border-radius: 8px;\n`;\n\nfunction renderEmails() {\n  if (data.emails.none || data.emails.items.length === 0) {\n    return `<p style=\"${mutedStyle}\">No unread emails from the last 24 hours.</p>`;\n  }\n\n  return data.emails.items.map(email => `\n    <div style=\"${cardStyle}\">\n      <div style=\"font-weight:600; font-size:14px;\">\n        ${escapeHtml(email.subject)}\n      </div>\n      <div style=\"margin-top:5px; font-size:13px;\">\n        ${escapeHtml(email.senderName)}\n        <span style=\"${mutedStyle}\">\n          &nbsp;·&nbsp; ${escapeHtml(email.sentRaw)}\n        </span>\n      </div>\n      <div style=\"margin-top:8px; font-size:13px; line-height:1.6;\">\n        ${escapeHtml(email.summary)}\n      </div>\n    </div>\n  `).join('');\n}\n\nfunction renderEvents() {\n  if (data.events.none || data.events.items.length === 0) {\n    return `<p style=\"${mutedStyle}\">No events for today.</p>`;\n  }\n\n  return `\n    <ul style=\"padding-left:20px; margin-top:0; line-height:1.9; font-size:14px;\">\n      ${data.events.items.map(event => `\n        <li>\n          <b>${escapeHtml(event.name)}</b>\n          <span style=\"${mutedStyle}\">\n            — ${escapeHtml(event.timeSlot)}${event.location ? ` | Location: ${escapeHtml(event.location)}` : ''}\n          </span>\n        </li>\n      `).join('')}\n    </ul>\n  `;\n}\n\nfunction renderTasks() {\n  if (data.tasks.none || data.tasks.items.length === 0) {\n    return `<p style=\"${mutedStyle}\">No tasks today.</p>`;\n  }\n\n  return `\n    <ul style=\"padding-left:20px; margin-top:0; line-height:1.9; font-size:14px;\">\n      ${data.tasks.items.map(task => `\n        <li>\n          <b>${escapeHtml(task.name)}</b>\n          ${task.dueRaw\n            ? `<span style=\"${mutedStyle}\"> — Due: ${escapeHtml(task.dueRaw)}</span>`\n            : ''}\n        </li>\n      `).join('')}\n    </ul>\n  `;\n}\n\nconst formattedDate = data.date\n  ? new Date(`${data.date}T12:00:00Z`).toLocaleDateString('en-GB', {\n      day: '2-digit',\n      month: 'short',\n      year: 'numeric',\n      timeZone: 'UTC',\n    })\n  : '';\n\nconst subject = `Daily Briefing - ${formattedDate}`;\n\nconst html = `\n<!DOCTYPE html>\n<html>\n<body style=\"margin:0; padding:0; background:#f4f6f8;\">\n  <div style=\"\n    max-width:680px;\n    margin:24px auto;\n    background:#ffffff;\n    border:1px solid #e0e3e7;\n    border-radius:12px;\n    overflow:hidden;\n    ${sectionStyle}\n  \">\n    <div style=\"\n      padding:24px 28px;\n      background:#1a365d;\n      color:#ffffff;\n    \">\n      <div style=\"font-size:23px; font-weight:600;\">\n        Daily Briefing\n      </div>\n      <div style=\"font-size:14px; margin-top:7px; color:#e2e8f0;\">\n        ${escapeHtml(formattedDate)}\n      </div>\n    </div>\n\n    <div style=\"padding:12px 28px 28px; ${sectionStyle}\">\n\n      <h2 style=\"${headingStyle}\">Emails</h2>\n      ${renderEmails()}\n\n      <h2 style=\"${headingStyle}\">Today's Events</h2>\n      ${renderEvents()}\n\n      <h2 style=\"${headingStyle}\">Tasks Due</h2>\n      ${renderTasks()}\n\n    </div>\n\n    <div style=\"\n      padding:14px 28px;\n      background:#f8f9fa;\n      border-top:1px solid #e0e3e7;\n      font-size:12px;\n      color:#5f6368;\n    \">\n      Daily Briefing · Automatically generated\n    </div>\n  </div>\n</body>\n</html>\n`;\n\nreturn {\n  json: {\n    subject,\n    html,\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        7696,
